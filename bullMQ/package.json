{
  "name": "bullmq",
  "description": "BullMQ in Monorepo concept",
  "author": "Dilum Darshana <dilum.dar@gmail.com>",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start": "turbo start",
    "docker:redis": "docker compose up -d redis",
    "docker:redis:stop": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bullmq": "^5.81.2"
  }
}
